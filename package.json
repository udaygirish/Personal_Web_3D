{
  "name": "udays-universe",
  "version": "1.0.0",
  "private": true,
  "description": "Static space portfolio with an optional owner-only Google-authenticated gateway",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-blog.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "highlight.js": "11.12.0",
    "http-proxy-middleware": "4.2.0",
    "katex": "0.18.7",
    "marked": "18.0.12",
    "openid-client": "6.8.8",
    "sanitize-html": "2.17.7",
    "session-file-store": "1.5.0"
  },
  "devDependencies": {
    "htmlparser2": "12.0.0",
    "prettier": "3.9.6"
  }
}
