# Optional home-hosted gateway; the public portfolio still works as static files.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Set to 1 only behind a trusted reverse proxy connecting from loopback.
TRUST_PROXY=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
# Optional stronger binding to your Google account's immutable subject ID.
OWNER_GOOGLE_SUB=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Canonical public site URL, including trailing deployment subpath if applicable.
SITE_URL=
